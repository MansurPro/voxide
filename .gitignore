/target
**/*.rs.bk

# Model weights are downloaded by `voxide models pull`, never committed.
/models/
*.onnx

# fastembed's default cache location, relative to the working directory. Nothing
# should write here any more -- SemanticMatcher pins the cache to
# ~/.cache/voxide/models -- but a build from before that fix still would.
/.fastembed_cache/

# Local per-user state written by the CLI during development.
/.voxide/
